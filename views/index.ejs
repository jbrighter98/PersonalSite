<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Joe Brighter</title>

    <link rel="stylesheet" href="style.css">
    <script src="https://kit.fontawesome.com/6c1c3d0aa2.js" crossorigin="anonymous"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <!-- ===================================== -->
    <!-- Navigation -->
    <!-- ===================================== -->

    <header>
        <nav class="navbar">

            <a href="#" class="logo">
                <span>Joe</span>Brighter
            </a>

            <ul class="nav-links">
                <li><a href="#hero">Home</a></li>
                <li><a href="#about">What I Do</a></li>
                <li><a href="#portfolio">Portfolio</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

        </nav>
    </header>


    <!-- ===================================== -->
    <!-- Hero -->
    <!-- ===================================== -->

    <section id="hero">

        <div class="hero-content">

            <p class="hero-intro">
                Hello, I'm
            </p>

            <h1>Joe Brighter</h1>

            <h2>
                Software Developer and Engineer • Musician
            </h2>

            <p class="hero-description">
                I'm a passionate software engineer and hobbyist musician based in Philadelphia, PA. I love creating innovative solutions and composing music that resonates with people.
            </p>

            <div class="hero-buttons">
                <a href="#portfolio" class="btn primary">
                    View Portfolio
                </a>

                <a href="#contact" class="btn secondary">
                    Contact Me
                </a>
            </div>

        </div>

        <div class="hero-image">

            <img src="images/MePortrait.jpg"
                alt="Profile Picture">

        </div>

    </section>



    <!-- ===================================== -->
    <!-- What I Do -->
    <!-- ===================================== -->

    <section id="about">

        <div class="section-heading">

            <h2>What I Do</h2>

            <p>
                A quick overview of my skills and interests.
            </p>

        </div>

        <div class="services-grid">

            <article class="service-card">

                <div class="service-icon">
                    💻
                </div>

                <h3>Software Development</h3>

                <p>
                    I specialize in Full-Stack web development, creating responsive and user-friendly applications. My expertise includes JavaScript, Python, and various frameworks and libraries.
                </p>

            </article>

            <article class="service-card">

                <div class="service-icon">
                    🧠
                </div>

                <h3>AI Development</h3>

                <p>
                    I have experience in developing and training AI, including machine learning models and neural networks.
                </p>

            </article>

            <article class="service-card">

                <div class="service-icon">
                    🎹
                </div>

                <h3>Music</h3>

                <p>
                    Classically trained in guitar, I have taught myself piano and music production. I enjoy composing and producing music in my free time.
                </p>
                <div class="social-links">
                    <a href="https://www.youtube.com/@josephbrighter3384" target="_blank"><i class="fa-brands fa-youtube"></i></a>
                </div>

            </article>

            <article class="service-card">

                <div class="service-icon">
                    📖
                </div>

                <h3>Studying Physics</h3>

                <p>
                    I study physics in my free time, exploring the fundamental principles of the universe and how they apply to technology and everyday life. This has been my passion since I was a child.
                </p>

            </article>

        </div>

    </section>



    <!-- ===================================== -->
    <!-- Portfolio -->
    <!-- ===================================== -->

    <section id="portfolio">

        <div class="section-heading">

            <h2>Featured Projects</h2>

            <p>
                A small selection of my recent work.
            </p>

        </div>

        <div class="portfolio-grid" id="work-list">

            <% if (items && items.length > 0) { %>
                <% let count = 0; %>
                <% items.forEach(item => { %>
                    <% if (count >= 3) return; %>
                    <a href="<%= item.destination %>" style="text-decoration: none; color: inherit;">
                        <article class="project-card">
                            <img src="<%= item.image %>" alt="<%= item.title %>">
                            <div class="project-content prevent-select">
                                <h3><%= item.title %></h3>
                                <p>
                                    <%= item.description %>
                                </p>
                            </div>
                        </article>
                    </a>
                    <% count++; %>
                <% }); %>
            <% } else { %>
                <p>No projects available at the moment. Please check back later!</p>
            <% } %>

        </div>

        <div class="portfolio-button">

                <a href="/projects" class="btn primary">
                    View All Projects
                </a>

        </div>

    </section>



    <!-- ===================================== -->
    <!-- Contact -->
    <!-- ===================================== -->

    <section id="contact">

        <div class="section-heading">

            <h2>Let's Connect</h2>

            <p>
                Interested in working together or just saying hello?
            </p>

        </div>

        <div class="contact-container">

            <div class="contact-info">

                <h3>Contact Information</h3>

                <p>Email</p>
                <p>Joe.Brighter98@gmail.com</p>

                <p>Socials</p>

                <div class="social-links">

                    <a href="https://www.linkedin.com/in/joseph-brighter-53607a176/" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="https://www.facebook.com/joe.brighter.9" target="_blank"><i class="fa-brands fa-facebook"></i></a>
                    <a href="https://www.instagram.com/joe.brighter/?hl=en" target="_blank"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://github.com/jbrighter98" target="_blank"><i class="fa-brands fa-square-github"></i></a>

                </div>

            </div>

            <form class="contact-form" name="submit-to-google-sheet">

                <input
                    type="text"
                    name="Name"
                    placeholder="Your Name"
                >
                <input
                    type="email"
                    name="Email"    
                    placeholder="Email"
                >
                <textarea
                    name="Message"
                    rows="6"
                    placeholder="Message"
                ></textarea>
                <input type="hidden" name="Timestamp" id="timestamp">
                <button type="submit" class="btn primary">
                    Send Message
                </button>

            </form>
            <span id="msg"></span>

        </div>

    </section>



    <!-- ===================================== -->
    <!-- Footer -->
    <!-- ===================================== -->

    <footer>

        <p>
            © 2026 Joe Brighter. All Rights Reserved.
        </p>

    </footer>

    <script src="script.js"></script>
    <script src="portfolioScript.js"></script>

        <script>
            fetch('./portfolio.json')
                .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json(); // Parse the JSON data from the response
                })
                .then(data => {
                // 'data' now contains the parsed JSON object
                displayProjects(data, "desc", 3);
                })
                .catch(error => {
                console.error('Error fetching or parsing JSON:', error);
                });
        </script>

</body>
</html>

