<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Joe Brighter | Portfolio</title>

    <link rel="stylesheet" href="style.css">
    <script src="https://kit.fontawesome.com/6c1c3d0aa2.js" crossorigin="anonymous"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <!-- ===================================== -->
    <!-- Navigation -->
    <!-- ===================================== -->

    <header>
        <nav class="navbar">

            <a href="/" class="logo">
                <span>Joe</span>Brighter
            </a>

            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/#about">What I Do</a></li>
                <li><a href="/#contact">Contact</a></li>
            </ul>

        </nav>
    </header>


    <!-- ===================================== -->
    <!-- Portfolio -->
    <!-- ===================================== -->

    <section id="portfolio">

        <div class="section-heading">

            <h2>My Projects</h2>

            <p>
                Here is a collection of my projects. Each project reflects my dedication to learning and my passion for creating innovative solutions.
            </p>

        </div>

        <div class="portfolio-grid" id="work-list">

            <% if (items && items.length > 0) { %>
                <% items.forEach(item => { %>
                    <a href="<%= item.destination %>" style="text-decoration: none; color: inherit;">
                        <article class="project-card">
                            <img src="<%= item.image %>" alt="<%= item.title %>">
                            <div class="project-content prevent-select">
                                <h3><%= item.title %></h3>
                                <p>
                                    <%= item.description %>
                                </p>
                            </div>
                        </article>
                    </a>
                <% }); %>
            <% } else { %>
                <p>No projects available at the moment. Please check back later!</p>
            <% } %>
        </div>


    </section>





    <!-- ===================================== -->
    <!-- Footer -->
    <!-- ===================================== -->

    <footer>

        <p>
            © 2026 Joe Brighter. All Rights Reserved.
        </p>

    </footer>

    <script src="portfolioScript.js"></script>

